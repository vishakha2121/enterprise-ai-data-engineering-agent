# ============================================
# ENTERPRISE AI DATA ENGINEERING AGENT
# .gitignore
# ============================================

# --------------------------------------------
# Python
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
.venv/
.env/
pythonenv*/
pip-log.txt
pip-delete-this-directory.txt

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Environments (secret!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Spark
spark-warehouse/
metastore_db/
derby.log
*.crc
*.log

# --------------------------------------------
# Node.js / React / Frontend
# --------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend builds
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vuepress/dist/

# Vite
.vite/
*.local

# Package managers
.pnpm-store/
.yarn/
.yarnrc.yml
package-lock.json
yarn.lock
pnpm-lock.yaml

# --------------------------------------------
# Environment Variables (SECRET - Never commit!)
# --------------------------------------------
.env
.env.*
!.env.example
*.env.local
secrets.json
credentials.json
config.secret.json

# --------------------------------------------
# Database
# --------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/backups/*
!database/backups/.gitkeep
database/app.db

# --------------------------------------------
# Data Files (large - don't commit)
# --------------------------------------------
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/output/*
!backend/data/output/.gitkeep
*.csv
*.parquet
*.avro
*.orc
!backend/data/samples/*.csv
!backend/data/samples/*.json
!backend/data/samples/*.parquet

# --------------------------------------------
# Logs
# --------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/*
!backend/logs/.gitkeep
airflow/logs/
*.pid

# --------------------------------------------
# IDE / Editor
# --------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --------------------------------------------
# OS Files
# --------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*~

# --------------------------------------------
# Docker
# --------------------------------------------
.dockerignore
docker-compose.override.yml

# --------------------------------------------
# Testing & Coverage
# --------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# --------------------------------------------
# Build artifacts
# --------------------------------------------
*.tsbuildinfo
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
.temp/
.tmp/

# --------------------------------------------
# Airflow
# --------------------------------------------
airflow.cfg
airflow.db
airflow-webserver.pid
webserver_config.py
unittests.cfg
logs/

# --------------------------------------------
# Kafka
# --------------------------------------------
kafka-logs/
kafka-data/
zookeeper-data/

# --------------------------------------------
# Spark
# --------------------------------------------
spark-events/
spark-warehouse/
.delta/
_delta_log/

# --------------------------------------------
# ML Models / Artifacts
# --------------------------------------------
*.h5
*.pkl
*.joblib
*.model
models/
checkpoints/

# --------------------------------------------
# Temporary files
# --------------------------------------------
*.bak
*.backup
*.old
*.orig
*.rej
tmp/
temp/

# --------------------------------------------
# Misc
# --------------------------------------------
.cursor/
.aider*
continue/
