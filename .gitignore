.env
.env.*
!.env.example
*.env.local
secrets.json
credentials.json
config.secret.json

# --------------------------------------------
# Database
# --------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/backups/*
!database/backups/.gitkeep
database/app.db

# --------------------------------------------
# Data Files (large - don't commit)
# --------------------------------------------
backend/data/uploads/*
!backend/data/uploads/.gitkeep
backend/data/output/*
!backend/data/output/.gitkeep
*.csv
*.parquet
*.avro
*.orc
!backend/data/samples/*.csv
!backend/data/samples/*.json
!backend/data/samples/*.parquet

# --------------------------------------------
# Logs
# --------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/logs/*
!backend/logs/.gitkeep
airflow/logs/
*.pid

